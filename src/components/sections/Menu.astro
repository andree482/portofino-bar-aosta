---
// Il menu è scritto come testo HTML (non PDF) così Google può leggerlo.
import { menu } from "../../data/menu";
---

<section id="menu" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-16">
  <h2 class="font-display text-3xl">Menu</h2>
  {menu.map((category) => (
    <div class="mt-8">
      <h3 class="text-xl font-semibold">{category.name}</h3>
      <ul class="mt-4 divide-y divide-black/10">
        {category.items.map((item) => (
          <li class="flex justify-between gap-4 py-2">
            <span>
              {item.name}
              {item.description && (
                <span class="text-muted block text-sm">{item.description}</span>
              )}
            </span>
            <span class="tabular-nums">{item.price}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
