---
// Dati strutturati schema.org: aiutano Google, Maps e gli assistenti AI (ChatGPT, Gemini,
// Claude, Perplexity...) a capire chi siamo, dove siamo, quando siamo aperti e come
// contattarci, e a collegare il sito al profilo Instagram.
// Due "schede" collegate tra loro:
// - il locale (bar, caffetteria e negozio di abbigliamento): nome e varianti, indirizzo,
//   orari, telefono, menù, social;
// - il sito (WebSite): Google lo usa per il nome del sito mostrato sopra il risultato.
import { site } from "../../data/site";
import { lingue, linguaDa, testi } from "../../i18n/lingue";

const siteUrl = Astro.site?.toString() ?? "";
const lingua = linguaDa(Astro.url);

const { instagram, facebook, tripadvisor } = site.social;
const sameAs = [instagram, facebook, tripadvisor].filter(Boolean);

const bar = {
  // Bar + caffetteria + boutique: così chi cerca "caffè e shopping ad Aosta" trova noi
  "@type": ["BarOrPub", "CafeOrCoffeeShop", "ClothingStore"],
  "@id": `${siteUrl}#bar`,
  name: site.fullName,
  alternateName: site.alternateNames,
  slogan: testi[lingua].seo.slogan,
  legalName: site.legalName || undefined,
  vatID: site.vatNumber ? `IT${site.vatNumber}` : undefined,
  // Descrizione nella lingua della pagina (src/i18n/, voce seo.descrizione)
  description: testi[lingua].seo.descrizione,
  url: siteUrl,
  image: new URL(site.ogImage, siteUrl).toString(),
  logo: new URL("/icon-512.png", siteUrl).toString(),
  priceRange: site.priceRange,
  servesCuisine: site.servesCuisine,
  hasMenu: `${siteUrl}#menu`,
  // Si prenota telefonando
  acceptsReservations: Boolean(site.contact.phone),
  telephone: site.contact.phone || undefined,
  email: site.contact.email || undefined,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street || undefined,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  hasMap: site.mapsUrl || undefined,
  areaServed: { "@type": "City", name: site.address.city },
  // I giorni di chiusura (senza orari) non si indicano: Google li considera chiusi.
  openingHoursSpecification: site.openingHours
    .filter((h) => h.opens && h.closes)
    .map((h) => ({
      "@type": "OpeningHoursSpecification",
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
  sameAs: sameAs.length ? sameAs : undefined,
};

const website = {
  "@type": "WebSite",
  "@id": `${siteUrl}#sito`,
  name: site.fullName,
  alternateName: site.alternateNames,
  url: siteUrl,
  // Lingue in cui è scritto il sito
  inLanguage: lingue,
  publisher: { "@id": `${siteUrl}#bar` },
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [bar, website],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
