---
// Freccia del design (asta + punta), disegnata in SVG.
// Prende il colore del testo intorno (currentColor).
//
// Esempi:
//   <Arrow />                              → freccia verso destra lunga 25px
//   <Arrow direction="up-right" length={21} />
//   <Arrow direction="down" length={147} />
//   <Arrow angle={-56} length={13} />      → inclinazione libera, come nel Figma

interface Props {
  direction?: "right" | "left" | "down" | "up" | "up-right";
  /** Inclinazione in gradi (0 = destra, -90 = su). Se indicata sostituisce `direction`. */
  angle?: number;
  /** Lunghezza dell'asta in px. */
  length?: number;
  /** Lunghezza dei due tratti della punta in px. */
  head?: number;
  /** Spessore della linea in px. */
  strokeWidth?: number;
  class?: string;
}

const {
  direction = "right",
  angle,
  length = 25,
  head = 6.4,
  strokeWidth = 2,
  class: className,
} = Astro.props;

const angles = { right: 0, down: 90, left: 180, up: -90, "up-right": -45 };
const rad = ((angle ?? angles[direction]) * Math.PI) / 180;

// Punti della freccia orientata verso destra, poi ruotati nella direzione scelta.
const rotate = ([x, y]: number[]) => [
  x * Math.cos(rad) - y * Math.sin(rad),
  x * Math.sin(rad) + y * Math.cos(rad),
];
const tail = rotate([0, 0]);
const tip = rotate([length, 0]);
const headA = rotate([length - head, -head]);
const headB = rotate([length - head, head]);

// Riquadro che contiene tutti i punti, con un margine pari allo spessore.
const points = [tail, tip, headA, headB];
const pad = strokeWidth;
const minX = Math.min(...points.map((p) => p[0])) - pad;
const minY = Math.min(...points.map((p) => p[1])) - pad;
const width = Math.max(...points.map((p) => p[0])) - minX + pad;
const height = Math.max(...points.map((p) => p[1])) - minY + pad;

const r = (n: number) => Math.round(n * 100) / 100;
const d = `M${r(tail[0])} ${r(tail[1])}L${r(tip[0])} ${r(tip[1])}M${r(headA[0])} ${r(headA[1])}L${r(tip[0])} ${r(tip[1])}L${r(headB[0])} ${r(headB[1])}`;
---

<svg
  class:list={["shrink-0", className]}
  width={r(width)}
  height={r(height)}
  viewBox={`${r(minX)} ${r(minY)} ${r(width)} ${r(height)}`}
  fill="none"
  aria-hidden="true"
>
  <path
    d={d}
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
