---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Pagina non trovata"
  noindex
  background="cream"
  footerTone="dark"
>
  <section class="container-site py-24 text-navy lg:py-40">
    <p class="text-[16px] tracking-tightest lg:text-[24px]">ERRORE 404</p>
    <h1 class="font-serif text-[50px] leading-none tracking-tightest lg:text-[100px]">
      Pagina non trovata
    </h1>
    <p class="mt-4 text-[18px] tracking-tightest lg:text-[30px]">
      La pagina che cerchi non esiste o è stata spostata.
    </p>
    <Button href="/" variant="navy" class="mt-8 h-12 px-6 text-[20px]">
      Torna alla home
    </Button>
  </section>
</BaseLayout>
