---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Pagina non trovata" noindex>
  <section class="mx-auto max-w-6xl px-4 py-24">
    <h1 class="font-display text-4xl">Pagina non trovata</h1>
    <p class="text-muted mt-4">
      La pagina che cerchi non esiste o è stata spostata.
    </p>
    <a href="/" class="text-accent mt-8 inline-block underline">
      Torna alla home
    </a>
  </section>
</BaseLayout>
