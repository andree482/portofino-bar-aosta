---
// Sezione "Il menù": menù del giorno con data, diviso in categorie.
// I piatti si modificano in src/data/menu.ts.
import Button from "../../components/ui/Button.astro";
import ScrollCue from "../../components/ui/ScrollCue.astro";
import { menu } from "../../data/menu";
import { bookingUrl } from "../../data/site";
---

<section id="menu" class="bg-navy text-white">
  <div class="container-site pt-[47px] pb-[77px] lg:pt-[60px] lg:pb-[67px]">
    <!-- Solo mobile: indicatore che invita a scorrere verso il menù -->
    <ScrollCue
      href="#menu-del-giorno"
      label="Scopri il menù"
      align="start"
      arrowLength={44}
      class="mb-[60px] text-cream lg:hidden"
    />

    <div
      id="menu-del-giorno"
      class="border-b-2 border-white pb-[9px] font-serif tracking-tightest lg:pb-[31px]"
    >
      <h2 class="text-[30px] lg:text-[80px] lg:leading-[1.375]">Il menù</h2>
    </div>

    <!-- Categorie: una colonna su mobile, due colonne su desktop -->
    <div class="mt-[25px] grid gap-y-[44px] lg:mt-[31px] lg:grid-flow-col lg:grid-cols-[minmax(0,498px)_minmax(0,498px)] lg:grid-rows-2 lg:justify-between lg:gap-y-[59px]">
      {menu.map((category) => (
        <div>
          <h3 class="font-serif text-[25px] text-gold uppercase lg:text-[56px] lg:leading-[1.375]">
            {category.name}
          </h3>
          <ul class="mt-[1px] border-b-2 border-white pb-[18px] text-[12px] leading-[1.18] font-medium tracking-tightest lg:mt-[10px] lg:divide-y-2 lg:divide-white lg:border-t-2 lg:border-b-0 lg:pb-0 lg:text-[40px] lg:leading-[1.2]">
            {category.items.map((item) => (
              <li class="flex justify-between gap-6 lg:py-[15px]">
                <span class="lg:-mr-[17px]">{item.name}</span>
                {item.price && (
                  <span class="whitespace-nowrap">{item.price}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-[77px] flex justify-center lg:mt-[75px]">
      <Button
        href={bookingUrl}
        arrow="right"
        arrowLength={23}
        arrowStroke={1}
        arrowHead={3.7}
        desktopArrow={{ length: 43, stroke: 3, head: 9.5 }}
        layout="justify-start gap-[20px] pl-[28px] lg:justify-center lg:gap-[0.4em] lg:pl-0"
        class="h-[30px] w-[199px] text-[15px] font-medium lg:h-[67px] lg:w-[498px] lg:text-[30px] lg:tracking-normal"
      >
        Prenota un tavolo
      </Button>
    </div>
  </div>
</section>
