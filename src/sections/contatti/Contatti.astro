---
// Sezione "Restiamo in contatto": telefono, email e Instagram, con il logo grande.
// I contatti si modificano in src/data/site.ts; i testi in src/i18n/ (voce contatti).
import Logo from "../../components/ui/Logo.astro";
import { site } from "../../data/site";
import { linguaDa, testi } from "../../i18n/lingue";

const t = testi[linguaDa(Astro.url)].contatti;
const { phone, email } = site.contact;
const { instagram, instagramHandle } = site.social;

// Ogni riga: etichetta, valore mostrato, link. Se il valore manca si vede il segnaposto e
// la riga non è cliccabile. `external` = si apre in una nuova scheda (Instagram).
const contacts = [
  {
    label: t.numero,
    value: phone || t.segnapostoNumero,
    href: phone ? `tel:${phone.replace(/\s/g, "")}` : undefined,
  },
  {
    label: t.email,
    value: email || t.segnapostoEmail,
    href: email ? `mailto:${email}` : undefined,
  },
  {
    label: t.instagram,
    value: instagramHandle || t.segnapostoInstagram,
    href: instagram || undefined,
    external: true,
  },
];

// Il valore arriva fino alla fine della linea: se non ci sta finisce con "…", sempre allineati a destra.
const rowClass =
  "grid grid-cols-[167px_minmax(0,1fr)] items-center py-[19px] lg:grid-cols-[249px_minmax(0,1fr)] lg:py-[27px]";
---

<section id="contatti" class="bg-navy text-white">
  <div class="container-site grid pt-[22px] pb-[54px] lg:grid-cols-[629fr_498fr] lg:items-center lg:gap-x-[133px] lg:pt-[119px] lg:pb-[117px]">
    <div data-reveal class="lg:col-start-2 lg:row-start-1">
      <!-- Sopratitolo: solo su mobile, come nel Figma -->
      <p class="text-[18px] font-medium lg:hidden">
        {t.sopratitolo}
      </p>
      <h2 class="mt-[2px] max-w-[291px] font-serif text-[60px] leading-[1.05] tracking-tightest text-cream lg:mt-0 lg:max-w-[457px] lg:text-[100px] lg:leading-[1.1]">
        {t.titolo}
      </h2>
      <p class="mt-[18px] max-w-[280px] text-[13px] leading-[1.2] lg:leading-normal font-medium tracking-label lg:mt-[30px] lg:max-w-[466px] lg:text-[23px]">
        {t.testo}
      </p>

      <ul class="mt-[30px] divide-y-2 divide-white border-t-2 border-white text-[30px] leading-[1.1] tracking-tightest lg:mt-[25px] lg:text-[30px] lg:tracking-label">
        {contacts.map((contact, index) => (
          <li data-reveal style={`--reveal-delay: ${150 + index * 100}ms`}>
            {contact.href ? (
              <a
                href={contact.href}
                class:list={[rowClass, "group"]}
                {...(contact.external && {
                  target: "_blank",
                  rel: "noopener",
                })}
              >
                <span>{contact.label}</span>
                {/* Linea sotto = cliccabile (copre anche i "…"); al passaggio del mouse diventa piena */}
                <span
                  title={contact.value}
                  class="max-w-full justify-self-start truncate border-b border-white/50 text-white/90 transition-colors duration-300 group-hover:border-white group-hover:text-white group-focus-visible:border-white"
                >
                  {contact.value}
                </span>
              </a>
            ) : (
              <div class={rowClass}>
                <span>{contact.label}</span>
                <span class="truncate">{contact.value}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Logo grande: sotto i contatti su mobile, a sinistra su desktop -->
    <div
      data-reveal="fade"
      style="--reveal-delay: 200ms"
      class="mt-[25px] lg:col-start-1 lg:row-start-1 lg:mt-0"
    >
      <Logo
        class="w-full max-w-[355px] lg:max-w-[629px]"
        widths={[360, 720, 1260]}
        sizes="(min-width: 1024px) 629px, 355px"
        loading="lazy"
      />
    </div>
  </div>
</section>
