---
// Sezione "Cosa trovi da noi": introduzione alla cucina con foto a tutta larghezza.
// I testi sono in src/i18n/ (voce cosaTrovi), nelle tre lingue.
import { Image } from "astro:assets";
import photo from "../../assets/images/pranzo-pasta.jpg";
import { linguaDa, testi } from "../../i18n/lingue";

const t = testi[linguaDa(Astro.url)].cosaTrovi;
---

<section id="cosa-trovi" class="bg-navy text-white">
  <div class="container-site pt-[30px] pb-[43px] text-center lg:pt-[56px]">
    <p
      data-reveal="fade"
      class="text-[9px] font-medium tracking-tightest text-gold lg:text-[22px]"
    >
      {t.attivita}
    </p>
    <p
      data-reveal
      style="--reveal-delay: 100ms"
      class="mt-[9px] text-[24px] font-medium tracking-tightest lg:mt-[17px] lg:text-[55px] lg:leading-[1.1]"
    >
      {t.sopratitolo}
    </p>
    <h2
      data-reveal
      style="--reveal-delay: 200ms"
      class="mx-auto mt-[22px] max-w-[301px] font-serif text-[40px] leading-[1.37] tracking-tightest lg:-mt-[5px] lg:max-w-none lg:text-[min(90px,6.15vw)]"
    >
      {t.titolo}
    </h2>
    <p
      data-reveal
      style="--reveal-delay: 300ms"
      class="mx-auto mt-[26px] max-w-[344px] text-[24px] tracking-tightest lg:mt-[19px] lg:max-w-[1105px] lg:text-[38px] leading-[1.2]"
    >
      {t.testo}
    </p>
  </div>

  <!--
    La foto si scopre dal basso e si assesta (animazioni image + zoom).
    Su tablet è più alta nella stessa proporzione del contenitore ingrandito (vedi global.css).
  -->
  <div
    data-reveal="image"
    style="--reveal-cover: var(--color-navy)"
    class="relative overflow-hidden"
  >
    <Image
      data-reveal="zoom"
      src={photo}
      alt={t.altFoto}
      widths={[640, 1024, 1536]}
      sizes="100vw"
      class="h-[160px] w-full object-cover min-[540px]:h-[200px] md:h-[240px] lg:h-[461px] lg:object-[center_56%]"
    />
  </div>
</section>
