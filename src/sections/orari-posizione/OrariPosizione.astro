---
// Sezione "Orari e posizione": orari di apertura, indirizzo e mappa.
// Orari e indirizzo si modificano in src/data/site.ts.
import { Image } from "astro:assets";
import Button from "../../components/ui/Button.astro";
import { site, fullAddress, directionsUrl } from "../../data/site";
import photoDesktop from "../../assets/images/orari-aperitivo.jpg";
import photoMobile from "../../assets/images/orari-caffe.jpg";
import mapImage from "../../assets/images/mappa-portofino.jpg";
---

<section id="orari" class="bg-cream text-navy">
  <div class="container-site pt-[26px] pb-[23px] lg:pt-[90px] lg:pb-[89px]">
    <!-- Intestazione: a sinistra su mobile, centrata su desktop -->
    <div data-reveal class="lg:text-center">
      <p class="text-[18px] font-medium text-brown lg:text-[30px]">
        Orari e posizione
      </p>
      <h2 class="max-w-[259px] font-serif text-[50px] leading-[0.95] tracking-tightest lg:-mt-[16px] lg:max-w-none lg:text-[80px] lg:leading-[1.375]">
        Ci vediamo al Portofino
      </h2>
      <p class="mt-[8px] max-w-[295px] text-[18px] leading-[1.2] lg:leading-normal tracking-tightest lg:mt-0 lg:max-w-none lg:text-[24px]">
        Per un pranzo, un caffè o un aperitivo: ecco dove trovarci.
      </p>
    </div>

    <div class="mt-[26px] grid gap-y-[20px] lg:mt-[39px] lg:grid-cols-[604fr_585fr] lg:gap-x-[51px]">
      <!-- Quando passare -->
      <div data-reveal>
        <h3 class="font-serif text-[30px] leading-[0.98] tracking-tightest lg:text-[65px] lg:leading-[1.375]">
          Quando passare
        </h3>
        <dl class="mt-[18px] divide-y divide-navy border-y border-navy text-[18px] tracking-tightest lg:mt-[16px] lg:text-[40px]">
          {site.openingHours.map((row) => (
            <div class="flex justify-between gap-4 py-[18px] lg:py-[19px]">
              <dt>{row.label}</dt>
              <dd class="text-right">
                {row.opens && row.closes
                  ? `${row.opens} - ${row.closes}`
                  : "Chiuso"}
              </dd>
            </div>
          ))}
        </dl>
        <p class="mt-[19px] text-[18px] leading-[1.2] lg:leading-normal tracking-tightest lg:mt-[26px] lg:text-[24px]">
          Gli orari potranno variare
        </p>
        <!--
          Foto diversa su mobile (solo caffè) e su desktop (caffè e aperitivo), come nel design.
          Ritaglio e proporzioni sono quelli del Figma (la foto è leggermente deformata):
          - mobile: alta 151.6% del riquadro e spostata in alto del 51.6%;
          - desktop: 105.67% × 111.6% del riquadro, spostata del 5.67% a sinistra e 5.8% in alto.
        -->
        <div
          data-reveal="image"
          style="--reveal-delay: 200ms"
          class="relative mt-[10px] h-[109px] overflow-hidden lg:hidden"
        >
          <Image
            src={photoMobile}
            alt="Un caffè espresso sul bancone del Portofino"
            widths={[400, 800]}
            sizes="100vw"
            class="absolute top-[-51.6%] left-0 h-[151.6%] w-full max-w-none"
          />
        </div>
        <div
          data-reveal="image"
          style="--reveal-delay: 200ms"
          class="relative mt-[8px] hidden aspect-[572/256] w-full max-w-[572px] overflow-hidden lg:block"
        >
          <Image
            src={photoDesktop}
            alt="Un caffè e uno spritz sul bancone del Portofino"
            widths={[650, 1300]}
            sizes="605px"
            class="absolute top-[-5.8%] left-[-5.67%] h-[111.6%] w-[105.67%] max-w-none"
          />
        </div>
      </div>

      <!-- Dove siamo -->
      <div data-reveal style="--reveal-delay: 150ms">
        <h3 class="font-serif text-[30px] leading-[0.98] tracking-tightest lg:text-[65px] lg:leading-[1.375]">
          Dove siamo
        </h3>
        <!-- Indirizzo completo: solo su desktop, come nel Figma -->
        <address class="hidden text-[40px] tracking-tightest not-italic lg:block">
          {fullAddress}
        </address>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener"
          data-reveal="image"
          style="--reveal-delay: 300ms"
          class="group relative mt-[20px] block overflow-hidden lg:mt-[8px]"
        >
          <Image
            src={mapImage}
            alt={`Mappa: come raggiungere ${site.fullName}`}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 585px, 100vw"
            class="aspect-[350/144] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] lg:aspect-[585/395]"
          />
          <!-- Attribuzione obbligatoria: la mappa è disegnata con i dati OpenStreetMap -->
          <span class="absolute bottom-1 left-2 text-[8px] text-navy/70 lg:bottom-2 lg:left-3 lg:text-[11px]">
            © OpenStreetMap
          </span>
        </a>
        <div
          data-reveal
          style="--reveal-delay: 400ms"
          class="mt-[25px] flex justify-center lg:mt-[24px] lg:justify-start"
        >
          <Button
            href={directionsUrl}
            variant="navy"
            arrowAngle={-56}
            arrowLength={12.8}
            arrowStroke={1}
            arrowHead={3.2}
            desktopArrow={{ angle: -41, length: 21.3, stroke: 2, head: 6.4 }}
            layout="justify-center gap-[7px] lg:gap-[11px]"
            external
            class="h-[26px] w-[199px] text-[18px] lg:h-[53px] lg:w-[283px] lg:text-[24px]"
          >
            Ottieni indicazioni
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
