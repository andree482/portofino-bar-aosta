---
// Prima schermata della home: foto della sala, titolo e invito a scoprire il menù.
import { Image } from "astro:assets";
import Button from "../../components/ui/Button.astro";
import ScrollCue from "../../components/ui/ScrollCue.astro";
import heroImage from "../../assets/images/hero-sala.jpg";
import mobileShade from "../../assets/images/hero-sfumatura-mobile.svg";
---

<section class="relative isolate flex min-h-svh overflow-hidden text-cream lg:min-h-[max(100svh,720px)]">
  <!-- Foto di sfondo (il blu a sinistra è già nella foto) -->
  <Image
    src={heroImage}
    alt="La sala del Portofino con le pareti blu e la parete dei vini"
    widths={[640, 960, 1280, 1487]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover object-[52%_center]"
  />
  <!-- Solo mobile: sfumatura blu dietro al testo per renderlo leggibile -->
  <img
    src={mobileShade.src}
    alt=""
    aria-hidden="true"
    class="absolute top-[-140px] left-[-216px] -z-10 h-[768px] w-[820px] max-w-none lg:hidden"
  />

  <div class="container-site flex flex-col pt-[153px] pb-12 lg:justify-center lg:py-[144px]">
    <h1 class="max-w-[340px] font-serif text-[35px] leading-[1.1] tracking-tightest lg:max-w-[752px] lg:text-[65px]">
      Tutto in un posto. <br />
      Tutto al momento giusto.
    </h1>
    <p class="mt-[19px] max-w-[244px] text-[21px] tracking-tightest lg:mt-[15px] lg:max-w-[667px] lg:text-[40px] leading-[1.2]">
      Colazione, pranzo, aperitivo, shopping. Benvenuto al Portofino Bar.
    </p>
    <Button
      href="#menu"
      arrow="right"
      class="mt-[22px] h-[31px] self-start px-4 text-[21px] lg:mt-[31px] lg:h-12 lg:px-[15px] lg:text-[24px] lg:font-medium"
    >
      Scopri il menù di oggi
    </Button>

    <ScrollCue
      href="#chi-siamo"
      label="scopri chi siamo"
      arrowOffset={25.5}
      arrowLength={48}
      class="mt-[69px] self-start text-white lg:absolute lg:bottom-[25px] lg:left-[159px] lg:mt-0"
    />
  </div>
</section>
