---
// Prima schermata della home: foto della sala, titolo e invito a scoprire il menù.
// I testi sono in src/i18n/ (voce hero), nelle tre lingue.
import { Image } from "astro:assets";
import Button from "../../components/ui/Button.astro";
import ScrollCue from "../../components/ui/ScrollCue.astro";
import heroImage from "../../assets/images/hero-sala.jpg";
import mobileShade from "../../assets/images/hero-sfumatura-mobile.svg";
import { linguaDa, testi } from "../../i18n/lingue";

const t = testi[linguaDa(Astro.url)].hero;
---

<section
  data-hero
  class="relative isolate flex min-h-svh overflow-hidden text-cream lg:min-h-[max(100svh,720px)]"
>
  <!--
    Foto di sfondo (il blu a sinistra è già nella foto).
    Animazioni all'apertura: la foto si assesta lentamente (zoom), poi titolo, testo,
    pulsante e indicatore compaiono uno dopo l'altro (vedi src/styles/animazioni.css).
  -->
  <Image
    data-reveal="zoom"
    src={heroImage}
    alt={t.altFoto}
    widths={[640, 960, 1280, 1487]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover object-[52%_center]"
  />
  <!-- Solo mobile: sfumatura blu dietro al testo per renderlo leggibile -->
  <img
    src={mobileShade.src}
    alt=""
    aria-hidden="true"
    class="absolute top-[-140px] left-[-216px] -z-10 h-[768px] w-[820px] max-w-none lg:hidden"
  />

  <div class="container-site flex flex-col pt-[153px] pb-12 lg:justify-center lg:py-[144px]">
    <h1
      data-reveal
      style="--reveal-delay: 150ms"
      class="max-w-[340px] font-serif text-[35px] leading-[1.1] tracking-tightest lg:max-w-[752px] lg:text-[65px]"
    >
      <!-- Ogni riga del titolo va a capo -->
      {t.titolo.map((riga, i) => <>{i > 0 && <br />}{riga}</>)}
    </h1>
    <p
      data-reveal
      style="--reveal-delay: 300ms"
      class="mt-[19px] max-w-[244px] text-[21px] tracking-tightest lg:mt-[15px] lg:max-w-[667px] lg:text-[40px] leading-[1.2]"
    >
      {t.sottotitolo}
    </p>
    <Button
      href="#menu"
      arrow="right"
      data-reveal
      style="--reveal-delay: 450ms"
      class="mt-[22px] h-[31px] self-start px-4 text-[21px] lg:mt-[31px] lg:h-12 lg:px-[15px] lg:text-[24px] lg:font-medium"
    >
      {t.pulsante}
    </Button>

    <ScrollCue
      href="#chi-siamo"
      label={t.scorri}
      arrowOffset={25.5}
      arrowLength={51}
      data-reveal
      style="--reveal-delay: 650ms"
      class="mt-[69px] self-start text-white lg:absolute lg:bottom-[25px] lg:left-[159px] lg:mt-0"
    />
  </div>
</section>

<script>
  // Passaggio automatico fluido da questa schermata a "Chi siamo" (e ritorno).
  import "../../scripts/passaggio-hero";
</script>
