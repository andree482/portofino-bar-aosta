---
// Struttura comune a tutte le pagine: <head> con SEO, header, contenuto e footer.
// La lingua della pagina (it, fr, en) si ricava dal suo indirizzo: vedi src/i18n/.
// Il banner cookie (src/components/layout/cookie-banner) chiede il consenso per i cookie
// facoltativi (Google Analytics): le statistiche partono solo se il visitatore accetta.
import "@fontsource-variable/inclusive-sans";
import "@fontsource/dm-serif-display/400.css";
import "../styles/global.css";
import Seo from "../components/seo/Seo.astro";
import LocalBusinessSchema from "../components/seo/LocalBusinessSchema.astro";
import GoogleAnalytics from "../components/seo/GoogleAnalytics.astro";
import CookieBanner from "../components/layout/cookie-banner/CookieBanner.astro";
import Header from "../components/layout/header/Header.astro";
import Footer from "../components/layout/footer/Footer.astro";
import {
  linguaDa,
  linguaInternazionale,
  testi,
  versioni,
} from "../i18n/lingue";

interface Props {
  /** Titolo della pagina per Google (senza nome del locale, viene aggiunto da solo). */
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Colore di sfondo della pagina: si vede anche dietro gli angoli arrotondati del footer. */
  background?: "navy" | "cream";
  /** true = header sopra la foto iniziale (home). */
  headerOverlay?: boolean;
  /** Colori del footer: light (crema) o dark (blu). */
  footerTone?: "light" | "dark";
}

const {
  background = "navy",
  headerOverlay = false,
  footerTone = "light",
  ...seo
} = Astro.props;

const lingua = linguaDa(Astro.url);
// Indirizzo di questa stessa pagina nelle tre lingue (per la scelta automatica, sotto)
const pagine = versioni(Astro.url);
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <!--
      Lingua automatica: apre il sito nella lingua scelta con il selettore IT / FR / EN
      (salvata nel browser alla voce "lingua") oppure, se non è mai stata scelta, nella
      lingua del dispositivo; per le lingue diverse da italiano e francese, in inglese.
      Non interviene con i motori di ricerca, che devono vedere ogni versione così com'è.
      È in cima alla pagina perché il cambio avvenga prima che la pagina compaia.
    -->
    <script is:inline define:vars={{ lingua, pagine, linguaInternazionale }}>
      try {
        const bot = /bot|crawl|spider|slurp|lighthouse|preview/i;
        const salvata = localStorage.getItem("lingua");
        let scelta = salvata in pagine ? salvata : null;
        if (!scelta && !bot.test(navigator.userAgent)) {
          const preferite = navigator.languages?.length
            ? navigator.languages
            : [navigator.language || ""];
          const codici = preferite.map((l) => l.slice(0, 2).toLowerCase());
          scelta =
            codici.find((codice) => codice in pagine) || linguaInternazionale;
        }
        if (scelta && scelta !== lingua) {
          location.replace(pagine[scelta] + location.search + location.hash);
        }
      } catch {
        // Browser senza memoria locale (es. alcune navigazioni private): resta la lingua della pagina.
      }
    </script>
    <!-- Segnala che JavaScript è attivo: serve alle animazioni (src/styles/animazioni.css) -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <!--
      Google Analytics: dopo la scelta della lingua (così non conta due volte una pagina
      che cambia lingua) e solo con il consenso ai cookie facoltativi.
    -->
    <GoogleAnalytics />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#072768" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} />
    <LocalBusinessSchema />
  </head>
  <body
    class:list={[
      "min-h-dvh antialiased",
      background === "cream" ? "bg-cream" : "bg-navy",
    ]}
  >
    <a
      href="#contenuto"
      class="sr-only rounded bg-cream px-4 py-2 text-navy focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      {testi[lingua].layout.vaiAlContenuto}
    </a>
    <Header overlay={headerOverlay} />
    <main id="contenuto">
      <slot />
    </main>
    <Footer tone={footerTone} />
    <CookieBanner />
    <script>
      import "../scripts/animazioni";
    </script>
  </body>
</html>
